{
  "benchmark": "agentlongbench",
  "target_model": "${TARGET_MODEL}",
  "draft_model": "${DRAFT_MODEL}",
  "tokenizer": "${TARGET_MODEL}",
  "served_model": "Qwen/Qwen3-8B",
  "model": "Qwen/Qwen3-8B-FC",
  "gpu": 0,
  "port": 8000,
  "base_url": "http://127.0.0.1:8000/v1",
